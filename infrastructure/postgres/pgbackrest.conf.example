# Copy outside the checkout, chmod 0600, then supply private values.
# A dedicated bucket/prefix and encryption key are required per environment.
[global]
repo1-type=s3
repo1-s3-bucket=REPLACE_WITH_DEDICATED_BUCKET
repo1-s3-endpoint=REPLACE_WITH_S3_HOSTNAME
repo1-s3-region=REPLACE_WITH_REGION
repo1-s3-key=REPLACE_WITH_ACCESS_KEY
repo1-s3-key-secret=REPLACE_WITH_SECRET_KEY
repo1-path=/3bont/production
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_SEPARATELY_PROTECTED_PASSPHRASE
repo1-retention-full-type=time
repo1-retention-full=30
repo1-storage-verify-tls=y
start-fast=y
process-max=2
archive-timeout=60
log-level-console=warn
log-level-file=off

[fantasy]
pg1-path=/var/lib/postgresql/data
pg1-socket-path=/var/run/postgresql
pg1-user=fantasy
pg1-database=fantasy
