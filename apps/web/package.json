{
  "name": "@fantasy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1 --port 3100",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "lint": "eslint src tests --max-warnings 0",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@fantasy/application": "workspace:*",
    "@fantasy/contracts": "workspace:*",
    "@fantasy/domain": "workspace:*",
    "@fantasy/persistence": "workspace:*",
    "@fontsource-variable/cairo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "better-auth": "1.7.5",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
