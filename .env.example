APP_BASE_URL=http://127.0.0.1:3100
DATABASE_URL=postgresql://fantasy:REPLACE_PASSWORD@127.0.0.1:54329/fantasy
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
